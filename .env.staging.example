# Staging environment template — PLAN.md §3.
#
# Copy to .env on the staging server and fill the secrets. Never commit the
# filled version.
#
# Staging exists so the §7 demo has somewhere to live and so the deploy path is
# exercised before production needs it. It carries realistic data, so it gets
# the same rules production gets.

APP_NAME="Construction ERP (Staging)"
APP_ENV=staging
APP_KEY=
# Never true outside local. A debug page renders the stack trace, and the stack
# trace contains the database credentials.
APP_DEBUG=false
APP_URL=https://staging.example.test

APP_LOCALE=en
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

# Its own database. A staging deploy pointed at production's database is the
# mistake that ends a company — and `migrate:fresh --seed` is a documented part
# of the demo workflow.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=construction_staging
DB_USERNAME=construction_staging
DB_PASSWORD=

# A least-privilege database user per environment, per PLAN.md §3. The staging
# user must not be able to reach the production schema at all.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Redis and Supervisor-managed workers: PLAN.md §2 disqualifies shared hosting
# for exactly this reason — a payroll run approximated by a per-minute cron dies
# halfway and leaves a half-posted ledger.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log

# Telescope on staging only, never production (PLAN.md §2).
TELESCOPE_ENABLED=true

# Sentry, free tier. Leave blank to disable.
SENTRY_LARAVEL_DSN=

# Off-server backups. A snapshot on the same VPS is not a backup (PLAN.md §9).
BACKUP_DISK=b2

# The password every seeded demo account gets (P6-08). REQUIRED on staging, and
# may not be `password` — the demo reset creates an administrator and every
# approval-matrix approver, on a public subdomain. Seeding refuses without it.
DEMO_ADMIN_PASSWORD=

# Two-factor authentication. Switched OFF for now; set to true to enforce it on
# Finance, HR and Admin accounts (setup on first login, then a code each sign-in).
TWO_FACTOR_ENABLED=false
